    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "d98c025c5ccd40709e8908567568111c",
    "m_Title": "1 - x = x",
    "m_Content": "Considering the bool as a bit\n0 (false) or 1 (true)\n\nwe take 1 - x and set the value\n\n1 - 1 = 0 (false)\n\n1 - 0 = 1 (true)",
